rules_version = '2';
// 9Wings Flora & Wedding — who can read and change the data.
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// Summary
//  - Nothing is readable or writable without signing in, except the one-time "owner exists" check.
//  - Only people added under Team (and switched on) can use the data.
//  - Staff: add and edit clients, bookings, invoices, payments, expenses, services.
//  - Owner only: delete anything, remove or change recorded payments, business settings, team.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() {
      return signedIn() && exists(memberPath()) && get(memberPath()).data.active == true;
    }
    function isOwner() { return isMember() && get(memberPath()).data.role == 'owner'; }
    // Record ids are generated by the app (letters, digits, - and _ only).
    function validId(id) { return id.matches('^[A-Za-z0-9_-]{1,64}$'); }
    // A record's own "id" field, when present, must match its document id.
    function idMatches(id) { return !('id' in request.resource.data) || request.resource.data.id == id; }
    function sane(id) { return validId(id) && idMatches(id) && request.resource.data.keys().size() <= 60; }

    // Who owns the business. Anyone may check whether it exists (so the app knows to show "set up").
    // Created once, by the first account, together with that account's team record. Never changed from the app.
    match /meta/owner {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/owner)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && getAfter(memberPath()).data.role == 'owner';
      allow update, delete: if false;
    }
    // Invoice number counters (numbers only).
    match /meta/counters {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.keys().size() <= 200;
      allow delete: if false;
    }
    match /meta/{docId} {
      allow read, write: if false;
    }

    // Team.
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      // The owner adds people; the very first owner creates their own record in the same step as /meta/owner.
      allow create: if (isOwner()
          && request.resource.data.role in ['owner', 'staff']
          && request.resource.data.active is bool)
        || (signedIn() && uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.active == true
          && getAfter(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid);
      // Owner manages others; nobody can demote or switch off themselves.
      allow update: if (isOwner() && request.resource.data.role in ['owner', 'staff'] && request.resource.data.active is bool
          && (uid != request.auth.uid || (request.resource.data.role == 'owner' && request.resource.data.active == true)))
        // Anyone may change their own display name — nothing else.
        || (isMember() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'name', 'updatedAt', 'updatedBy']));
      allow delete: if isOwner() && uid != request.auth.uid;
    }

    // Business settings: everyone in the team reads, only the owner changes.
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isOwner() && docId == 'business';
    }

    // Invoices & quotations.
    // Staff can add payments but cannot remove or change payments already recorded.
    match /invoices/{id} {
      allow read: if isMember();
      allow create: if isMember() && sane(id);
      allow update: if isMember() && sane(id) && (isOwner()
        || request.resource.data.get('payments', []).hasAll(resource.data.get('payments', [])));
      allow delete: if isOwner();
    }

    // Other business records: staff add and edit, only the owner deletes.
    match /{coll}/{id} {
      allow read: if isMember() && coll in ['customers', 'events', 'items', 'packages', 'expenses', 'offers'];
      allow create, update: if isMember() && sane(id) && coll in ['customers', 'events', 'items', 'packages', 'expenses', 'offers'];
      // Anyone can undo a "sent" mark on an offer; everything else only the owner deletes.
      allow delete: if (isOwner() && coll in ['customers', 'events', 'items', 'packages', 'expenses', 'offers'])
        || (isMember() && coll == 'offers');
    }
  }
}
